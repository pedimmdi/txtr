# Django core settings
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Comma-separated list of allowed hosts
# Docker Compose adds "web" as a hostname inside the network
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Optional — if unset, Django uses local SQLite (core/db.sqlite3)
# Docker Compose sets this automatically for the web service:
# DATABASE_URL=postgres://txtr:txtr@db:5432/txtr
# DATABASE_URL=

# Optional — if unset, LocMem cache + InMemory channel layer
# Docker Compose sets this automatically for the web service:
# REDIS_URL=redis://redis:6379/0
# REDIS_URL=
